{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teho directory listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "address", "domains"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[^\\u0000-\\u001f]*$"},
    "description": {"type": "string", "maxLength": 240, "pattern": "^[^\\u0000-\\u001f]*$"},
    "address": {"type": "string", "minLength": 1, "description": "A hostname listed in domains, optionally followed by :port (1 to 65535). The build validates this relationship."},
    "domains": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"}
    }
  }
}
